{
  "name": "json-compare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"tsx watch server/index.ts --api-only\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts --api-only",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "bench": "vite-node scripts/bench.ts",
    "electron:bundle": "esbuild electron/main.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outfile=electron-dist/main.cjs --log-level=warning",
    "app": "npm run build && npm run electron:bundle && electron .",
    "package:dir": "npm run build && npm run electron:bundle && electron-builder --dir",
    "package:mac": "npm run build && npm run electron:bundle && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.57.0",
    "png2icons": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.4"
  },
  "description": "Fast JSON comparison tool for large documents, with read-only Redis loading",
  "author": "JSON Compare",
  "homepage": "https://github.com/leonardo2rms/json-compare",
  "main": "electron-dist/main.cjs",
  "build": {
    "appId": "com.jsoncompare.app",
    "productName": "JSON Compare",
    "artifactName": "JSON-Compare-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "JSON Compare ${version}"
    },
    "linux": {
      "target": "dir",
      "category": "Development"
    }
  }
}
